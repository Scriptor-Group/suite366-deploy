# Publishes suite366.local + the sub-domains via mDNS (like homeassistant.local),
# automatically resolved on the LAN without touching clients' /etc/hosts.
#
# The script /usr/local/bin/suite366-avahi-aliases.sh is generated by
# install.sh. It is a WATCHER: it polls the current LAN IP every 5s and
# (re)publishes one `avahi-publish -a -R <fqdn> <IP>` per name whenever the IP
# changes (also refreshing livekit's advertised WebRTC IP). Offline it just
# waits — no crash, no external hook needed. It stays in the foreground;
# systemd kills the whole group on stop.
#
# StartLimitIntervalSec=0: never let restart bursts (e.g. boot-time churn)
# leave the unit permanently dead in start-limit-hit.
#
# Installed in /etc/systemd/system/, then: systemctl enable --now suite366-avahi-aliases
[Unit]
Description=Suite 366 — mDNS aliases (*.suite366.local)
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/suite366-avahi-aliases.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
